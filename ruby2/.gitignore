# === Ruby High 2.0 .gitignore ===
# Goal: track source + design + scene data; exclude re-downloadable weights,
# Python venvs, and build artifacts.

# --- Model weights (re-downloadable) ---
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.bin
models/

# --- SAM / depth pipeline checkpoints ---
checkpoints/
visual-scene/checkpoints/

# --- Python venvs & caches (regenerable) ---
**/.venv/
**/venv/
**/env/
**/ENV/
**/site-packages/
**/lib/python*/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
pip-wheel-metadata/
.Python
pyvenv.cfg

# --- Native / C build artifacts ---
c/build/
c/bin/
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# --- Node ---
node_modules/

# --- OS / editor cruft ---
.DS_Store
*.swp
*~
