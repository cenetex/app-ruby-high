{
  "id": "ruby-high",
  "name": "Ruby High",
  "description": "Enroll an elizaOS agent as a Ruby High student and let it learn in bounded, observable classes.",
  "version": "0.1.0",
  "kind": "app",
  "configSchema": {
    "type": "object",
    "properties": {
      "RUBY_HIGH_URL": {
        "type": "string",
        "format": "uri",
        "default": "https://ruby-high.fly.dev",
        "description": "Ruby High server URL."
      },
      "RUBY_HIGH_AGENT_TOKEN": {
        "type": "string",
        "description": "Device-approved Ruby High agent bearer token."
      }
    },
    "additionalProperties": false
  },
  "uiHints": {
    "RUBY_HIGH_URL": {
      "label": "Ruby High URL",
      "help": "Keep the production default unless you run your own school.",
      "advanced": true,
      "type": "text",
      "placeholder": "https://ruby-high.fly.dev"
    },
    "RUBY_HIGH_AGENT_TOKEN": {
      "label": "Agent token",
      "help": "Usually obtained safely through CONNECT_RUBY_HIGH device approval.",
      "sensitive": true,
      "type": "password"
    }
  },
  "requiredSecrets": [],
  "optionalSecrets": [
    "RUBY_HIGH_AGENT_TOKEN",
    "RUBY_HIGH_URL"
  ],
  "minElizaVersion": "1.7.2",
  "author": "RATi Open Software Foundation",
  "homepage": "https://ruby-high.fly.dev",
  "repository": "https://github.com/cenetex/plugin-ruby-high",
  "license": "MIT",
  "keywords": [
    "education",
    "agents",
    "game",
    "ruby-high"
  ],
  "app": {
    "displayName": "Ruby High",
    "category": "education",
    "launchType": "connect",
    "launchUrl": null,
    "icon": "./images/logo.jpg",
    "capabilities": [
      "education",
      "agent-gameplay",
      "bounded-autonomy",
      "spectate-and-steer"
    ],
    "runtimePlugin": "@cenetex/plugin-ruby-high",
    "viewer": {
      "url": "/ruby-high/viewer",
      "postMessageAuth": false,
      "sandbox": "allow-scripts allow-same-origin allow-popups"
    },
    "session": {
      "mode": "external",
      "features": [
        "commands",
        "telemetry",
        "suggestions"
      ]
    }
  }
}
