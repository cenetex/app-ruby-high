{
  "name": "@cenetex/app-ruby-high",
  "version": "0.1.0",
  "description": "Ruby High — elizaOS app. Ruby hosts the school; specialist faculty (Sally Science, Professor Edward, etc.) handle deep-domain teaching.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js",
      "default": "./dist/routes.js"
    }
  },
  "files": [
    "dist",
    "elizaos.plugin.json",
    "assets"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/routes.ts --format esm --dts --clean",
    "build:spa": "npm run build && node scripts/build-spa.mjs",
    "spa:dev": "node scripts/serve-spa.mjs",
    "dev": "npm run build && node scripts/dev-server.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "start": "node scripts/server.mjs",
    "native:desktop:dev": "tauri dev",
    "native:desktop:build": "tauri build",
    "native:desktop:build:ci": "tauri build --config src-tauri/tauri.ci.conf.json",
    "native:osx:build": "tauri build --bundles app,dmg",
    "native:osx:build:ci": "tauri build --config src-tauri/tauri.ci.conf.json --bundles app,dmg",
    "native:windows:build": "tauri build --bundles nsis,msi",
    "native:windows:build:ci": "tauri build --config src-tauri/tauri.ci.conf.json --bundles nsis,msi",
    "native:linux:build": "tauri build --bundles deb,rpm,appimage",
    "native:linux:build:ci": "tauri build --config src-tauri/tauri.ci.conf.json --bundles deb,rpm,appimage",
    "native:mobile:init:ios": "cap add ios",
    "native:mobile:init:android": "cap add android",
    "native:mobile:sync": "npm run build:spa && cap sync",
    "native:ios:build": "npm run native:mobile:sync && cap build ios",
    "native:android:build": "npm run native:mobile:sync && cap build android",
    "native:ios:open": "npm run native:mobile:sync && cap open ios",
    "native:android:open": "npm run native:mobile:sync && cap open android",
    "typecheck": "tsc --noEmit && node scripts/check-viewer-script.mjs",
    "test": "vitest",
    "check": "npm run typecheck && npm test -- --run && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:prod": "node scripts/smoke.mjs https://ruby-high.fly.dev",
    "deploy": "flyctl deploy --app ruby-high --remote-only --build-arg RUBY_HIGH_BUILD=$(git rev-parse --short=12 HEAD) && npm run smoke:prod",
    "clean": "rm -rf dist dist-spa .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1041.0",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/lib-dynamodb": "^3.1041.0",
    "@elizaos/core": "2.0.0-alpha.535"
  },
  "peerDependencies": {
    "@elizaos/core": "2.0.0-alpha.535"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "elizaos",
    "eliza-plugin",
    "eliza-app",
    "ruby-high",
    "education",
    "quiz"
  ],
  "elizaos": {
    "kind": "app",
    "app": {
      "displayName": "Ruby High",
      "category": "education",
      "launchType": "connect",
      "launchUrl": null,
      "capabilities": [
        "education",
        "quiz",
        "multiple-choice",
        "spectate-and-steer"
      ],
      "runtimePlugin": "@cenetex/app-ruby-high",
      "viewer": {
        "url": "/api/apps/ruby-high/viewer",
        "sandbox": "allow-scripts allow-same-origin allow-popups allow-forms"
      },
      "session": {
        "mode": "spectate-and-steer",
        "features": [
          "commands",
          "telemetry",
          "suggestions"
        ]
      },
      "bridgeExport": "./dist/routes.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cenetex/app-ruby-high.git"
  }
}
