{
  "name": "@cenetex/app-ruby-high",
  "version": "0.1.0",
  "description": "Ruby High standalone app. Ruby hosts the school; specialist faculty (Sally Science, Professor Edward, etc.) handle deep-domain teaching.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js",
      "default": "./dist/routes.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "!assets/nft/grok-sources"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node --disable-warning=ExperimentalWarning scripts/fix-node-sqlite-import.mjs && node --disable-warning=ExperimentalWarning scripts/check-privy-client-bundle.mjs && node --disable-warning=ExperimentalWarning scripts/check-viewer-bundle.mjs",
    "build:spa": "npm run build && node --disable-warning=ExperimentalWarning scripts/build-spa.mjs",
    "spa:dev": "node scripts/serve-spa.mjs",
    "dev": "npm run build && node scripts/dev-server.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "start": "node scripts/server.mjs",
    "typecheck": "tsc --noEmit && node scripts/check-question-bank.mjs && node scripts/check-viewer-script.mjs",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=ExperimentalWarning\" vitest",
    "test:ci": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=ExperimentalWarning\" vitest --run --testTimeout=15000",
    "test:browser": "playwright test",
    "test:coverage": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=ExperimentalWarning\" vitest --run --coverage --testTimeout=15000",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run test:ci && npm run build",
    "check:browser": "npm run test:browser",
    "check:full": "npm run typecheck && npm run test:ci && npm run build:spa",
    "balance:report": "node scripts/balance-report.mjs",
    "nft:create-core-collection": "npm run build && node scripts/create-core-pack-collection.mjs",
    "nft:create-card-collection": "npm run build && node scripts/create-hall-pass-card-collection.mjs",
    "nft:upload-images:arweave": "node scripts/upload-nft-images-arweave.mjs",
    "nft:check-image-urls": "node scripts/check-nft-image-urls.mjs",
    "eval:voice": "npm run build && node scripts/eval-voice.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:prod": "node scripts/smoke.mjs https://ruby-high.fly.dev",
    "nft:crop-cards": "node scripts/generate-nft-card-crops.mjs",
    "deploy": "node scripts/deploy-fly.mjs",
    "clean": "rm -rf dist dist-spa .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-dynamodb": "^3.1106.0",
    "@irys/upload": "^0.0.15",
    "@irys/upload-solana": "0.0.4",
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@privy-io/node": "^0.28.0",
    "@solana-program/memo": "^0.12.0",
    "@solana-program/token": "^0.14.0",
    "@solana/kit": "^7.0.0",
    "@solana/web3.js": "^1.98.4",
    "arweave": "^1.15.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@privy-io/react-auth": "3.32.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "@irys/bundles": "0.0.3",
    "@irys/upload": "$@irys/upload",
    "@irys/upload-core": "0.0.10",
    "tmp": "^0.2.7",
    "@reown/appkit": "1.8.19",
    "@reown/appkit-controllers": "1.8.19",
    "@reown/appkit-pay": "1.8.19",
    "@reown/appkit-scaffold-ui": "1.8.19",
    "@reown/appkit-ui": "1.8.19",
    "@reown/appkit-utils": "1.8.19",
    "@walletconnect/core": "2.23.9",
    "@walletconnect/ethereum-provider": "2.23.9",
    "@walletconnect/sign-client": "2.23.9",
    "@walletconnect/universal-provider": "2.23.9",
    "@walletconnect/utils": "2.23.9",
    "axios": "1.19.0",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "hono": "4.12.34",
    "nanoid": "3.3.17",
    "postcss": "8.5.25",
    "socket.io-parser": "4.2.7",
    "uuid": "11.1.1",
    "viem": "2.50.4",
    "vite": "8.2.0",
    "ws": "8.21.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ruby-high",
    "education",
    "quiz"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cenetex/app-ruby-high.git"
  }
}
