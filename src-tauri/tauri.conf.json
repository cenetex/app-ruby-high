{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruby High",
  "version": "0.1.0",
  "identifier": "com.cenetex.rubyhigh",
  "build": {
    "beforeDevCommand": "npm run spa:dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run build:spa",
    "frontendDist": "../dist-spa"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ruby High",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Ruby High offline classroom",
    "longDescription": "Ruby High packaged as an offline native classroom app."
  }
}
